{
  "name": "toolbox-azure-devops",
  "publisher": "BerndFuhrmann",
  "displayName": "Toolbox for Azure Devops - by Bernd Fuhrmann",
  "description": "Access Azure Devops from within VSCode and similar",
  "version": "0.0.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/berndfuhrmann/toolbox-azure-devops"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "icon": "resources/icons/logo.png",
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepare": "pnpm run src-gen && pnpm run icons && pnpm run package && pnpm run vscode:prepare:meta",
    "vscode:prepare:meta": "node scripts/prepare-meta.cjs",
    "vscode:prepublish": "pnpm run vscode:prepare",
    "vscode:package": "pnpm run vscode:prepare && pnpm -C dist exec vsce package --out ../build --no-dependencies",
    "compile": "pnpm run check-types && pnpm run lint && node scripts/esbuild.cjs",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node scripts/esbuild.cjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:src-gen": "nodemon -w src-gen -e egl,flexmi,eol --exec \"pnpm run src-gen\"",
    "icons": "node ./scripts/prepare-icons.mjs",
    "src-gen": "mvn -f src-gen compile",
    "package": "pnpm run check-types && pnpm run lint && node scripts/esbuild.cjs --production",
    "compile-tests": "tsc -p . --outDir out && tsc -p test/integration/tsconfig.json",
    "watch-tests": "tsc -p . -w --outDir out && tsc -p test/integration/tsconfig.json -w",
    "preinttest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit && tsc -p test/integration/tsconfig.json --noEmit",
    "fix": "prettier . --write && pnpm run format:ps1",
    "format:ps1": "pwsh -ExecutionPolicy Bypass -File scripts/format-ps1.ps1",
    "lint": "eslint src",
    "inttest": "vscode-test",
    "test": "vitest --watch=false",
    "docs": "typedoc --out docs/typedoc --cleanOutputDir src/**/*.ts",
    "demo:record": "node scripts/esbuild.cjs && pnpm run compile-tests && node out/test/demo/recordDemos.js",
    "demo:convert": "pnpm run compile-tests && node out/test/demo/convertDemos.js --all",
    "demo:convert:single": "pnpm run compile-tests && node out/test/demo/convertDemos.js",
    "demo:generate": "pnpm run demo:record && pnpm run demo:convert",
    "demo:clean": "rimraf demos/output",
    "e2e:start": "pwsh -ExecutionPolicy Bypass -File test/e2e/startDemoServer.ps1",
    "e2e:stop": "pwsh -ExecutionPolicy Bypass -File test/e2e/stopDemoServer.ps1",
    "e2e:seed": "pnpm exec ts-node test/e2e/seed-demo.ts"
  },
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "@tabler/icons": "^3.40.0",
    "@types/he": "^1.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.107.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "^4.1.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.1.0",
    "ffmpeg-static": "^5.3.0",
    "gifski": "^1.7.1",
    "httpntlm": "^1.8.13",
    "jest-mock-vscode": "^4.12.0",
    "maven": "^5.0.0",
    "mocha": "^11.7.5",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.58.2",
    "prettier": "3.8.1",
    "rimraf": "^6.1.3",
    "sinon": "^21.0.3",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.18",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@nfi/tuplemap": "^1.0.1",
    "@sinclair/typebox": "^0.34.45",
    "@xmldom/xmldom": "^0.9.9",
    "azure-devops-node-api": "^15.1.2",
    "deep-equality-data-structures": "^2.0.0",
    "inversify": "^7.10.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
