operation Service getType() {
  if (self.type.isDefined()) {
    return self.type+"Api";
  } else {
    return self.name+"Api";
  }
}

operation Service getApiImportName() {
  var name : String = self.name;
  if (self.importName.isDefined()) {
    name = self.importName;
  }
  return name + "Api";
}

operation Service getInterfaceImportName() {
  var name : String = self.name;
  if (self.typeImportName.isDefined()) {
    name = self.typeImportName;
  }
  return name + "Interfaces";
}

operation Service getApiImport() {
  return "import { I" + self.getType() + " } from \"azure-devops-node-api/" + self.getApiImportName() + "\";";
}

operation Service getTypeImport() {
  var name : String = self.name;
  if (self.typeImport.isDefined()) {
    name = self.typeImport;
  }
  return "import * as " + name + "Interfaces from \"azure-devops-node-api/interfaces/" + self.getInterfaceImportName() + "\";";
}

operation String toCamelCase() {
    if (self.size() > 0) {
        return self.substring(0, 1).toLowerCase() + self.substring(1);
    } else {
        return self;
    }
}