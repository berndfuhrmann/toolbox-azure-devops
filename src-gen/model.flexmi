  <treeProvider
    name="RepositoryTreeProvider"
    module="repository"
    treePartProvider="RepositoryRootDeduplicatingTreePartProvider,GitRepositoryDetailStaticTreePartProvider,GitRepositoryBranchDetailStaticTreePartProvider,GitRepositoryCommitDetailStaticTreePartProvider,GitRepositoryPullRequestContentCombiningTreePartProvider,GitRepositoryTreePartProvider,GitRepositoryBranchTreePartProvider,GitRepositoryCommitTreePartProvider,GitRepositoryTagTreePartProvider,GitRepositoryPullRequestTreePartProvider,GitRepositoryPullRequestReviewerTreePartProvider,GitRepositoryPullRequestStatusTreePartProvider,GitRepositoryPullRequestCommentThreadTreePartProvider,GitRepositoryPullRequestWorkItemTreePartProvider,GitRepositoryItemTreePartProvider,PinnedGitRepositoryTreePartProvider,PinnedGitRepositoryPullRequestTreePartProvider,WorkItemContentsCombiningTreePartProvider,WorkItemDetailStaticTreePartProvider,HierarchyChildrenTreePartProvider,WorkItemLinkedWorkItemGroupsTreePartProvider,WorkItemCommentsTreePartProvider,WorkItemHistoryTreePartProvider,WorkItemRevisionFieldsTreePartProvider,AttachmentTreePartProvider,WorkItemLinkedCommitsTreePartProvider,WorkItemLinkedPullRequestsTreePartProvider,WorkItemLinkedBranchesTreePartProvider,WorkItemLinkedBuildsTreePartProvider,WorkItemLinkedWorkItemsTreePartProvider"
  >
    <treeProviderRule treePartProvider="RepositoryRootDeduplicatingTreePartProvider" />
    <treeProviderRule treeitem="AccountTreeItem" treePartProvider="ProjectUnwrappingTreePartProvider" />
    <treeProviderRule treeitem="ProjectTreeItem" treePartProvider="GitRepositoryTreePartProvider" />
    <treeProviderRule treeitem="GitRepositoryTreeItem" treePartProvider="GitRepositoryDetailStaticTreePartProvider" />
    <treeProviderRule treeitem="GitRepositoryItemsTreeItem" treePartProvider="GitRepositoryItemTreePartProvider" />
    <treeProviderRule treeitem="GitRepositoryItemTreeItem" treePartProvider="GitRepositoryItemTreePartProvider" />
    <treeProviderRule treeitem="GitRepositoryCommitsTreeItem" treePartProvider="GitRepositoryCommitTreePartProvider" />
    <treeProviderRule
      treeitem="GitRepositoryCommitTreeItem"
      treePartProvider="GitRepositoryCommitDetailStaticTreePartProvider"
    />
    <treeProviderRule treeitem="GitRepositoryBranchesTreeItem" treePartProvider="GitRepositoryBranchTreePartProvider" />
    <treeProviderRule
      treeitem="GitRepositoryBranchTreeItem"
      treePartProvider="GitRepositoryBranchDetailStaticTreePartProvider"
    />
    <treeProviderRule treeitem="GitRepositoryTagsTreeItem" treePartProvider="GitRepositoryTagTreePartProvider" />
    <treeProviderRule
      treeitem="GitRepositoryPullRequestsTreeItem"
      treePartProvider="GitRepositoryPullRequestTreePartProvider"
    />
    <treeProviderRule
      treeitem="GitRepositoryPullRequestTreeItem"
      treePartProvider="GitRepositoryPullRequestContentCombiningTreePartProvider"
    />
    <treeProviderRule
      treeitem="GitRepositoryPullRequestReviewersTreeItem"
      treePartProvider="GitRepositoryPullRequestReviewerTreePartProvider"
    />
    <treeProviderRule treeitem="WorkItemTreeItem" treePartProvider="WorkItemContentsCombiningTreePartProvider" />
    <treeProviderRule treeitem="WorkItemCommentsTreeItem" treePartProvider="WorkItemCommentsTreePartProvider" />
    <treeProviderRule treeitem="WorkItemHistoryTreeItem" treePartProvider="WorkItemHistoryTreePartProvider" />
    <treeProviderRule treeitem="WorkItemRevisionTreeItem" treePartProvider="WorkItemRevisionFieldsTreePartProvider" />
    <treeProviderRule treeitem="WorkItemAttachmentsTreeItem" treePartProvider="AttachmentTreePartProvider" />
    <treeProviderRule
      treeitem="WorkItemLinkedCommitsTreeItem"
      treePartProvider="WorkItemLinkedCommitsTreePartProvider"
    />
    <treeProviderRule
      treeitem="WorkItemLinkedPullRequestsTreeItem"
      treePartProvider="WorkItemLinkedPullRequestsTreePartProvider"
    />
    <treeProviderRule
      treeitem="WorkItemLinkedBranchesTreeItem"
      treePartProvider="WorkItemLinkedBranchesTreePartProvider"
    />
    <treeProviderRule treeitem="WorkItemLinkedBuildsTreeItem" treePartProvider="WorkItemLinkedBuildsTreePartProvider" />
    <treeProviderRule
      treeitem="WorkItemRelationGroupTreeItem"
      treePartProvider="WorkItemLinkedWorkItemsTreePartProvider"
    />
  </treeProvider>
  <treeProvider
