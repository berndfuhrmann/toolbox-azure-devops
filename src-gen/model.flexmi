      implementation="getWorkItemIconSvg(icon, color, v)"
    >
      <parameter name="icon" type="string" />
      <parameter name="color" type="string | undefined" />
      <parameter name="v" type="number | undefined" />
    </serviceMethod>
    <serviceMethod
      name="relationTypes"
      outputType="WorkItemTrackingInterfaces.WorkItemRelationType[]"
      implementation="getRelationTypes()"
    />
    <serviceMethod
