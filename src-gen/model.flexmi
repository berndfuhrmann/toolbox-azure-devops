<?nsuri toolboxazuredevopsbybf?>
<plugin>
  <service name="Alert">
    <serviceMethod
      name="alerts"
      outputType="AlertInterfaces.Alert[]"
      paged="true"
      implementation="getAlerts(project, repository, undefined, undefined, undefined, undefined, continuationToken)"
    >
      <parameter name="project" type="string" />
      <parameter name="repository" type="string" />
    </serviceMethod>
    <serviceMethod
      name="alertInstances"
      outputType="AlertInterfaces.AlertAnalysisInstance[]"
      implementation="getAlertInstances(project, alertId, repository)"
    >
      <parameter name="project" type="string" />
      <parameter name="alertId" type="number" />
      <parameter name="repository" type="string" />
    </serviceMethod>
  </service>
  <service name="Build">
    <serviceMethod
      name="artifacts"
      outputType="BuildInterfaces.BuildArtifact[]"
      implementation="getArtifacts(
        project, 
        buildId
      )"
    >
      <parameter name="project" type="string" />
      <parameter name="buildId" type="number" />
    </serviceMethod>
    <serviceMethod
      name="buildLogs"
      outputType="BuildInterfaces.BuildLog[]"
      implementation="getBuildLogs(
        project, 
        buildId
      )"
    >
      <parameter name="project" type="string" />
      <parameter name="buildId" type="number" />
    </serviceMethod>
    <serviceMethod
      name="buildTags"
      outputType="string[]"
      implementation="getBuildTags(
        project, 
        buildId
      )"
    >
      <parameter name="project" type="string" />
      <parameter name="buildId" type="number" />
    </serviceMethod>
    <serviceMethod
      name="definition"
      outputType="BuildInterfaces.BuildDefinitionReference"
      implementation="getDefinition(
        project, 
        definitionId,
      )"
    >
      <parameter name="project" type="string" />
      <parameter name="definitionId" type="number" />
    </serviceMethod>

    <serviceMethod
      name="definitions"
      outputType="BuildInterfaces.BuildDefinitionReference[]"
      paged="true"
      implementation="getDefinitions(
        project, 
        undefined, /* name */
        undefined, /* repositoryId */
        undefined, /* repositoryType */
        undefined, /* queryOrder */
        undefined, /* top */
        continuationToken,
        undefined, /* minMetricsTime */
        undefined, /* definitionIds */
        path
      )"
    >
      <parameter name="project" type="string" />
      <parameter name="path" type="string | undefined" />
    </serviceMethod>
    <serviceMethod
      name="folders"
      outputType="BuildInterfaces.Folder[]"
      paged="true"
      implementation="getFolders(project)"
    >
      <parameter name="project" type="string" />
    </serviceMethod>
    <serviceMethod
      name="builds"
      outputType="BuildInterfaces.Build[]"
      paged="true"
      implementation="getBuilds(
        project, 
        definitions,
        undefined /*queues*/,
        undefined /*buildNumber*/,
        undefined /*minTime*/,
        undefined /*maxTime*/,
        undefined /*requestedFor*/,
        undefined /*reasonFilter*/,
        undefined /*statusFilter*/,
        undefined /*resultFilter*/,
        undefined /*tagFilters*/,
        undefined /*properties*/,
        undefined /*top*/,
        continuationToken,
        undefined /*maxBuildsPerDefinition*/,
        undefined /*deletedFilter*/,
        undefined /*queryOrder*/,
        undefined /*branchName*/,
        undefined /*buildIds*/,
        undefined /*repositoryId*/,
        undefined /*repositoryType*/,
      )"
    >
      <parameter name="project" type="string" />
      <parameter name="definitions" type="number[] | undefined" />
    </serviceMethod>
    <serviceMethod
      name="buildTimeline"
      outputType="BuildInterfaces.Timeline"
      implementation="getBuildTimeline(project, buildId, undefined, undefined, undefined)"
    >
      <parameter name="project" type="string" />
      <parameter name="buildId" type="number" />
    </serviceMethod>
    <serviceMethod name="build" outputType="BuildInterfaces.Build" implementation="getBuild(project, buildId)">
      <parameter name="buildId" type="number" />
      <parameter name="project" type="string" />
    </serviceMethod>
  </service>
  <service name="Cix" importName="CIX" typeImportName="CIX"/>
  <service name="Core">
    <serviceMethod
      name="projects"
      outputType="CoreInterfaces.TeamProjectReference[]"
      paged="true"
      implementation="getProjects(undefined, undefined, undefined, continuationToken as number | undefined)"
    />
    <serviceMethod
      name="teams"
      outputType="CoreInterfaces.WebApiTeam[]"
      paged="true"
      implementation="getTeams(projectId, mine, continuationToken as number | undefined, undefined)"
    >
      <parameter name="projectId" type="string" />
      <parameter name="mine" type="boolean | undefined" />
    </serviceMethod>
    <serviceMethod
      name="allTeams"
      outputType="CoreInterfaces.WebApiTeam[]"
      paged="true"
      implementation="getAllTeams(mine, continuationToken as number | undefined, undefined)"
    >
      <parameter name="mine" type="boolean | undefined" />
    </serviceMethod>
    <serviceMethod
      name="teamMembersWithExtendedProperties"
      outputType="VSSInterfaces.TeamMember[]"
      paged="true"
      implementation="getTeamMembersWithExtendedProperties(projectId, teamId, continuationToken as number | undefined, undefined)"
    >
      <parameter name="projectId" type="string" />
      <parameter name="teamId" type="string" />
    </serviceMethod>
  </service>
  <service name="Dashboard">
    <serviceMethod
      name="dashboards"
      outputType="DashboardInterfaces.Dashboard[]"
      implementation="getDashboardsByProject(teamContext)"
    >
