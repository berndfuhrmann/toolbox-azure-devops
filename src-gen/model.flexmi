  <treeItem
    name="WorkItemLinkedCommitTreeItem"
    module="workItem"
    item="WorkItemLinkedItemItem"
    itemImport="/modules/workItem/items/WorkItemLinkedItemItem"
    inWeb="true"
  />
  <treeItem
    name="WorkItemLinkedPullRequestTreeItem"
    module="workItem"
    item="WorkItemLinkedItemItem"
    itemImport="/modules/workItem/items/WorkItemLinkedItemItem"
    inWeb="true"
  />
  <treeItem
    name="WorkItemLinkedBranchTreeItem"
    module="workItem"
    item="WorkItemLinkedItemItem"
    itemImport="/modules/workItem/items/WorkItemLinkedItemItem"
    inWeb="true"
  />
  <treeItem
    name="WorkItemLinkedBuildTreeItem"
    module="workItem"
    item="WorkItemLinkedItemItem"
    itemImport="/modules/workItem/items/WorkItemLinkedItemItem"
    inWeb="true"
  />

  <treepartprovider name="AgentPoolTreePartProvider" module="agents" pinnable="true" produces="AgentPoolTreeItem" />
  <treepartprovider name="AgentTreePartProvider" module="agents" pinnable="true" produces="AgentTreeItem" />
  <treepartprovider name="AgentJobTreePartProvider" module="agents" produces="AgentJobTreeItem" />
  <treepartprovider name="PinnedAgentPoolTreePartProvider" module="agents" produces="AgentPoolTreeItem" />
  <treepartprovider name="PinnedAgentTreePartProvider" module="agents" produces="AgentTreeItem" />

  <treeItem name="AgentPoolTreeItem" module="agents" item="AgentPoolItem" refreshable="true" pinnable="true" />
  <treeItem name="AgentsContainerTreeItem" module="agents" item="AgentPoolItem" refreshable="true" />
  <treeItem name="AgentTreeItem" module="agents" item="AgentItem" refreshable="true" pinnable="true" />
  <treeItem name="JobsContainerTreeItem" module="agents" item="AgentPoolItem" refreshable="true" />
  <treeItem name="AgentJobsContainerTreeItem" module="agents" item="AgentItem" refreshable="true" />
  <treeItem name="AgentJobTreeItem" module="agents" item="AgentJobItem" refreshable="true" />

  <treepartprovider name="DashboardWidgetTreePartProvider" module="dashboard" produces="DashboardWidgetTreeItem" />
  <treepartprovider name="DashboardTreePartProvider" module="dashboard" produces="DashboardTreeItem" />

  <!-- Derived TreePartProviders -->
  <!-- Account -->
  <unwrappingTreePartProvider
    name="AccountRootUnwrappingTreePartProvider"
    innerTreePartProvider="AccountTreePartProvider"
    childTreePartProvider="ProjectUnwrappingTreePartProvider"
    unwrapPredicate="shouldUnwrapAccountOrProject(this.#settingsService.unwrapAccounts())"
  />
  <unwrappingTreePartProvider
    name="ProjectUnwrappingTreePartProvider"
    innerTreePartProvider="ProjectTreePartProvider"
    childTreePartProvider="resolveAccountRootTreePartProvider"
    unwrapPredicate="shouldUnwrapAccountOrProject(this.#settingsService.unwrapProjects())"
  />

  <!-- Repository -->
  <combiningTreePartProvider name="RepositoryRootCombiningTreePartProvider">
    <entry key="pinnedPullRequests" childTreePartProvider="PinnedGitRepositoryPullRequestTreePartProvider" />
    <entry key="pinnedRepositories" childTreePartProvider="PinnedGitRepositoryTreePartProvider" />
    <entry key="accounts" childTreePartProvider="AccountRootUnwrappingTreePartProvider" />
  </combiningTreePartProvider>
  <deduplicatingTreePartProvider
    name="RepositoryRootDeduplicatingTreePartProvider"
    innerTreePartProvider="RepositoryRootCombiningTreePartProvider"
    dedupePredicate="dedupePinnedRepositories"
  />
  <staticTreePartProvider name="GitRepositoryDetailStaticTreePartProvider">
    <entry key="items" treeItem="GitRepositoryItemsTreeItem" />
    <entry key="branches" treeItem="GitRepositoryBranchesTreeItem" />
    <entry key="commits" treeItem="GitRepositoryCommitsTreeItem" />
    <entry key="tags" treeItem="GitRepositoryTagsTreeItem" />
    <entry key="pullRequests" treeItem="GitRepositoryPullRequestsTreeItem" />
  </staticTreePartProvider>
  <staticTreePartProvider name="GitRepositoryBranchDetailStaticTreePartProvider">
    <entry key="items" treeItem="GitRepositoryItemsTreeItem" />
    <entry key="commits" treeItem="GitRepositoryCommitsTreeItem" />
  </staticTreePartProvider>
  <staticTreePartProvider name="GitRepositoryCommitDetailStaticTreePartProvider">
    <entry key="items" treeItem="GitRepositoryItemsTreeItem" />
  </staticTreePartProvider>
  <staticTreePartProvider name="GitRepositoryPullRequestReviewersStaticTreePartProvider">
    <entry key="reviewers" treeItem="GitRepositoryPullRequestReviewersTreeItem" />
  </staticTreePartProvider>
  <combiningTreePartProvider name="GitRepositoryPullRequestContentCombiningTreePartProvider">
    <entry key="reviewers" childTreePartProvider="GitRepositoryPullRequestReviewersStaticTreePartProvider" />
    <entry key="status" childTreePartProvider="GitRepositoryPullRequestStatusTreePartProvider" />
    <entry key="commentThread" childTreePartProvider="GitRepositoryPullRequestCommentThreadTreePartProvider" />
    <entry key="workItems" childTreePartProvider="GitRepositoryPullRequestWorkItemTreePartProvider" />
  </combiningTreePartProvider>

  <!-- Pipeline -->
  <combiningTreePartProvider name="PipelineRootCombiningTreePartProvider">
    <entry key="pinnedPipelineFolders" childTreePartProvider="PinnedPipelineFolderTreePartProvider" />
    <entry key="pinnedPipelines" childTreePartProvider="PinnedPipelineTreePartProvider" />
    <entry key="accounts" childTreePartProvider="AccountRootUnwrappingTreePartProvider" />
  </combiningTreePartProvider>
  <deduplicatingTreePartProvider
    name="PipelineRootDeduplicatingTreePartProvider"
    innerTreePartProvider="PipelineRootCombiningTreePartProvider"
    dedupePredicate="dedupePinnedPipelines"
  />
  <combiningTreePartProvider name="PipelineFolderAndPipelineCombiningTreePartProvider">
    <entry key="pipelineFolder" childTreePartProvider="PipelineFolderTreePartProvider" />
    <entry key="pipeline" childTreePartProvider="PipelineTreePartProvider" />
  </combiningTreePartProvider>
  <staticTreePartProvider name="PipelineRunArtifactsStaticTreePartProvider">
    <entry key="artifacts" treeItem="PipelineArtifactsTreeItem" />
  </staticTreePartProvider>
  <combiningTreePartProvider name="PipelineRunDetailCombiningTreePartProvider">
    <entry key="artifacts" childTreePartProvider="PipelineRunArtifactsStaticTreePartProvider" />
    <entry key="timeline" childTreePartProvider="PipelineRunTimelineTreePartProvider" />
  </combiningTreePartProvider>

  <!-- Dashboard -->
  <staticTreePartProvider name="ProjectDashboardsStaticTreePartProvider">
    <entry key="dashboards" treeItem="DashboardsContainerTreeItem" />
  </staticTreePartProvider>

  <!-- WorkItem -->
  <combiningTreePartProvider name="WorkItemRootCombiningTreePartProvider">
    <entry key="pinnedWorkItems" childTreePartProvider="PinnedWorkItemTreePartProvider" />
    <entry key="pinnedAreaPaths" childTreePartProvider="PinnedWorkItemAreaPathTreePartProvider" />
    <entry key="pinnedTeams" childTreePartProvider="PinnedWorkItemTeamTreePartProvider" />
    <entry key="pinnedQueries" childTreePartProvider="PinnedWorkItemQueryLeafTreePartProvider" />
    <entry key="accounts" childTreePartProvider="AccountRootUnwrappingTreePartProvider" />
  </combiningTreePartProvider>
  <staticTreePartProvider name="MyWorkStaticTreePartProvider">
    <entry key="assignedToMe" treeItem="AssignedToMeTreeItem" />
    <entry key="mentioned" treeItem="MentionedTreeItem" />
    <entry key="recentlyModifiedByMe" treeItem="RecentlyModifiedByMeTreeItem" />
  </staticTreePartProvider>
  <staticTreePartProvider name="BacklogStaticTreePartProvider">
    <entry key="backlog" treeItem="WorkItemBacklogTreeItem" />
  </staticTreePartProvider>
  <staticTreePartProvider name="WorkItemDetailStaticTreePartProvider">
    <entry
      key="linkedCommits"
      treeItem="WorkItemLinkedCommitsTreeItem"
      condition="(itemObservable) => itemObservable.pipe(map((item) => (item.workItem?.relations?.some((relation: any) => relation.url?.startsWith('vstfs:///Git/Commit/') ?? false) ?? false)))"
    />
    <entry
      key="linkedPullRequests"
      treeItem="WorkItemLinkedPullRequestsTreeItem"
      condition="(itemObservable) => itemObservable.pipe(map((item) => (item.workItem?.relations?.some((relation: any) => relation.url?.startsWith('vstfs:///Git/PullRequestId/') ?? false) ?? false)))"
    />
    <entry
      key="linkedBranches"
      treeItem="WorkItemLinkedBranchesTreeItem"
      condition="(itemObservable) => itemObservable.pipe(map((item) => (item.workItem?.relations?.some((relation: any) => relation.url?.startsWith('vstfs:///Git/Ref/') ?? false) ?? false)))"
    />
    <entry
      key="linkedBuilds"
      treeItem="WorkItemLinkedBuildsTreeItem"
      condition="(itemObservable) => itemObservable.pipe(map((item) => (item.workItem?.relations?.some((relation: any) => relation.url?.startsWith('vstfs:///Build/Build/') ?? false) ?? false)))"
    />
    <entry
      key="comments"
      treeItem="WorkItemCommentsTreeItem"
      condition="(itemObservable) => itemObservable.pipe(map((item) => (item.workItem?.fields?.['System.CommentCount'] ?? 0) > 0))"
    />
    <entry
      key="attachments"
      treeItem="WorkItemAttachmentsTreeItem"
      condition="(itemObservable) => itemObservable.pipe(map((item) => (item.workItem?.relations?.some((relation: any) => relation.rel === 'AttachedFile') ?? false)))"
    />
  </staticTreePartProvider>
  <combiningTreePartProvider name="WorkItemContentsCombiningTreePartProvider">
    <entry key="children" childTreePartProvider="HierarchyChildrenTreePartProvider" />
    <entry key="details" childTreePartProvider="WorkItemDetailStaticTreePartProvider" />
    <entry key="linkedWorkItemGroups" childTreePartProvider="WorkItemLinkedWorkItemGroupsTreePartProvider" />
  </combiningTreePartProvider>
  <combiningTreePartProvider name="AreaPathNodeCombiningTreePartProvider">
    <entry key="areaPathChildren" childTreePartProvider="AreaPathChildrenTreePartProvider" />
    <entry key="hierarchy" childTreePartProvider="AreaPathHierarchyRootTreePartProvider" />
  </combiningTreePartProvider>
  <unwrappingTreePartProvider
    name="CurrentSprintUnwrappingTreePartProvider"
    innerTreePartProvider="CurrentSprintTreePartProvider"
    childTreePartProvider="CurrentSprintScopeTreePartProvider"
    unwrapPredicate="(items) => of(items.size === 1 &amp;&amp; !items.has('exception'))"
  />
  <combiningTreePartProvider name="TeamContentsCombiningTreePartProvider">
    <entry key="sprints" childTreePartProvider="CurrentSprintUnwrappingTreePartProvider" />
    <entry key="backlog" childTreePartProvider="BacklogStaticTreePartProvider" />
  </combiningTreePartProvider>

  <!-- Agents -->
  <combiningTreePartProvider name="AgentsRootCombiningTreePartProvider">
    <entry key="pinnedAgentPools" childTreePartProvider="PinnedAgentPoolTreePartProvider" />
    <entry key="pinnedAgents" childTreePartProvider="PinnedAgentTreePartProvider" />
    <entry key="accounts" childTreePartProvider="AccountRootUnwrappingTreePartProvider" />
  </combiningTreePartProvider>
  <staticTreePartProvider name="AgentPoolChildrenStaticTreePartProvider">
    <entry key="jobs" treeItem="JobsContainerTreeItem" />
    <entry key="agents" treeItem="AgentsContainerTreeItem" />
  </staticTreePartProvider>
  <staticTreePartProvider name="AgentChildrenStaticTreePartProvider">
    <entry key="jobs" treeItem="AgentJobsContainerTreeItem" />
  </staticTreePartProvider>

  <treeItem name="DashboardTreeItem" module="dashboard" inWeb="true" refreshable="true" />
  <treeItem name="DashboardWidgetTreeItem" module="dashboard" refreshable="true" />
  <treeItem
    name="DashboardsContainerTreeItem"
    module="dashboard"
    refreshable="true"
    item="ProjectItem"
    itemImport="/modules/core/items/ProjectItem"
  />

  <!-- Commands -->
  <command
    name="addOrganization"
    handler="addOrganizationAction"
    importPath="/modules/core/actions/addOrganizationAction"
    needsContainer="true"
    title="Add Organization"
    icon="organization-add"
  >
    <menuLocation location="view/title" when="!false" group="navigation">
      <!--allowInView>dashboard</allowInView-->
    </menuLocation>
  </command>
  <command
    name="removeOrganization"
    handler="removeOrganizationAction"
    importPath="/modules/core/actions/removeOrganizationAction"
    needsContainer="true"
    title="Remove Organization"
    icon="organization-remove"
  >
    <menuLocation location="view/item/context" when="viewItem =~ /,account,/" />
    <menuLocation location="view/title" when="toolbox-azure-devops-by-bf.accounts-unwrapped" group="navigation" />
  </command>
  <command
    name="updatePersonalAccessToken"
    handler="updatePersonalAccessTokenAction"
    importPath="/modules/core/actions/updatePersonalAccessTokenAction"
    needsContainer="true"
    title="Update Personal Access Token (PAT)"
    icon="pat-update"
  >
    <menuLocation location="view/item/context" when="viewItem =~ /,account,/" />
    <menuLocation location="view/title" when="toolbox-azure-devops-by-bf.accounts-unwrapped" group="navigation" />
  </command>
  <command
    name="openInWeb"
    handler="handleOpenInWebAction"
    importPath="/common/items/OpenInWebTreeItemMixin"
    needsContainer="false"
    title="Open in External Web Browser"
    icon="link"
  >
    <menuLocation location="view/item/context" when="viewItem =~ /,inWeb,/" group="inline@3" />
  </command>
  <command
    name="pin"
    handler="handlePinAction"
    importPath="/common/items/PinnedTreeItemMixin"
    needsContainer="false"
    title="Pin item"
    icon="pin"
  >
    <menuLocation
      location="view/item/context"
      when="viewItem =~ /,pinnable,/ &amp;&amp; !(viewItem =~ /,pinned,/)"
      group="inline@1"
    />
  </command>
  <command
    name="unpin"
    handler="handleUnpinAction"
    importPath="/common/items/PinnedTreeItemMixin"
    needsContainer="false"
    title="Unpin item"
    icon="pinned-off"
  >
    <menuLocation
      location="view/item/context"
      when="viewItem =~ /,pinnable,/ &amp;&amp; viewItem =~ /,pinned,/"
      group="inline@1"
    />
  </command>
  <command
    name="refresh"
    handler="handleRefreshAction"
    importPath="/common/items/RefreshableTreeItemMixin"
    needsContainer="false"
    title="Refresh"
    icon="refresh"
  >
    <menuLocation location="view/title" when="!false" group="navigation" />
    <menuLocation location="view/item/context" when="viewItem =~ /,refreshable,/" group="inline@2" />
  </command>
  <command
    name="workItem.downloadAttachment"
    handler="downloadAttachmentAction"
    importPath="/modules/workItem/actions/attachmentActions"
    needsContainer="true"
    title="Download Attachment"
    icon="download"
  >
    <menuLocation location="view/item/context" when="viewItem =~ /,workItem.attachment,/" group="inline" />
  </command>
  <command
    name="workItem.setState"
    handler="workItemSetStateAction"
    importPath="/modules/workItem/actions/workItemActions"
    needsContainer="true"
    title="Set State"
    icon="edit"
  >
    <menuLocation location="view/item/context" when="viewItem =~ /,workItem.workItem,/" group="navigation" />
  </command>
  <command
    name="workItem.setTitle"
    handler="workItemSetTitleAction"
    importPath="/modules/workItem/actions/workItemActions"
    needsContainer="true"
    title="Set Title"
    icon="edit"
  >
    <menuLocation location="view/item/context" when="viewItem =~ /,workItem.workItem,/" group="navigation" />
  </command>
  <command
    name="workItem.setEffort"
    handler="workItemSetEffortAction"
    importPath="/modules/workItem/actions/workItemActions"
    needsContainer="true"
    title="Set Effort"
    icon="edit"
  >
    <menuLocation location="view/item/context" when="viewItem =~ /,workItem.workItem,/" group="navigation" />
  </command>
  <command
    name="workItem.setAssignedTo"
    handler="workItemSetAssignedToAction"
    importPath="/modules/workItem/actions/workItemActions"
    needsContainer="true"
    title="Assign To"
    icon="edit"
  >
    <menuLocation location="view/item/context" when="viewItem =~ /,workItem.workItem,/" group="navigation" />
  </command>
  <!--command
    name="workItem.setSprint"
    handler="workItemSetSprintAction"
    importPath="/modules/workItem/actions/workItemActions"
    needsContainer="true"
    title="Set Sprint"
    icon="edit"
  >
    <menuLocation location="view/item/context" when="viewItem =~ /,workItem.workItem,/" group="navigation" />
  </command-->
  <command
    name="workItem.copyId"
    handler="workItemCopyIdAction"
    importPath="/modules/workItem/actions/workItemActions"
    needsContainer="false"
    title="Copy ID"
    icon="copy"
  >
    <menuLocation location="view/item/context" when="viewItem =~ /,workItem.workItem,/" group="navigation" />
  </command>
  <command
    name="openTextFile"
    handler="openTextFileAction"
    importPath="/common/openTextFileAction"
    needsContainer="true"
    title="Open Item"
  />
  <command
    name="gitRepository.pullRequest.setTitle"
    handler="gitRepositoryPullRequestSetTitleAction"
    importPath="/modules/repository/actions/gitRepositoryPullRequestActions"
    needsContainer="true"
    title="Set Title"
    icon="edit"
  >
    <menuLocation location="view/item/context" when="viewItem =~ /,gitRepository.pullRequest,/" group="navigation" />
  </command>
  <command
    name="pipeline.renameFolder"
    handler="pipelineRenameFolderAction"
    importPath="/modules/pipeline/actions/folderActions"
    needsContainer="true"
    title="Rename Folder"
  >
    <menuLocation location="view/item/context" when="viewItem =~ /,pipeline.folder,/" group="navigation" />
  </command>
  <command
    name="pipeline.createFolder"
    handler="pipelineCreateFolderAction"
    importPath="/modules/pipeline/actions/folderActions"
    needsContainer="true"
    title="Create Folder"
  >
    <menuLocation
      location="view/item/context"
      when="viewItem =~ /,pipeline.folder,/ || viewItem =~ /,common.project,/"
      group="navigation"
    />
  </command>
  <command
    name="pipeline.deleteFolder"
    handler="pipelineDeleteFolderAction"
    importPath="/modules/pipeline/actions/folderActions"
    needsContainer="true"
    title="Delete Folder"
  >
    <menuLocation location="view/item/context" when="viewItem =~ /,pipeline.folder,/" group="navigation" />
  </command>
  <command
    name="pipeline.revealRepository"
    handler="pipelineRevealRepositoryAction"
    importPath="/modules/pipeline/actions/pipelineActions"
    needsContainer="true"
    title="Reveal Repository"
  >
    <menuLocation location="view/item/context" when="viewItem =~ /,pipeline.pipeline,/" group="navigation" />
  </command>
  <command
    name="pipeline.renamePipeline"
    handler="pipelineRenamePipelineAction"
    importPath="/modules/pipeline/actions/pipelineActions"
    needsContainer="true"
    title="Rename Pipeline"
  >
    <menuLocation location="view/item/context" when="viewItem =~ /,pipeline.pipeline,/" group="navigation" />
  </command>
  <command
    name="pipeline.deletePipeline"
    handler="pipelineDeletePipelineAction"
    importPath="/modules/pipeline/actions/pipelineActions"
    needsContainer="true"
    title="Delete Pipeline"
  >
    <menuLocation location="view/item/context" when="viewItem =~ /,pipeline.pipeline,/" group="navigation" />
  </command>
  <command
    name="pipeline.runPipeline"
    handler="pipelineRunPipelineAction"
    importPath="/modules/pipeline/actions/pipelineActions"
    needsContainer="true"
    title="Run Pipeline"
  >
    <menuLocation location="view/item/context" when="viewItem =~ /,pipeline.pipeline,/" group="navigation" />
  </command>
  <command
    name="pipeline.cancelRun"
    handler="pipelineCancelRunAction"
    importPath="/modules/pipeline/actions/pipelineRunActions"
    needsContainer="true"
    title="Cancel Run"
  >
    <menuLocation location="view/item/context" when="viewItem =~ /,pipeline.run,/" group="navigation" />
  </command>
  <command
    name="pipeline.rerunRun"
    handler="pipelineRerunRunAction"
    importPath="/modules/pipeline/actions/pipelineRunActions"
    needsContainer="true"
    title="Re-run"
  >
    <menuLocation location="view/item/context" when="viewItem =~ /,pipeline.run,/" group="navigation" />
  </command>

  <!-- Configuration -->
  <configurationProperty
    name="autoRefreshInterval"
    defaultValue="null"
    description="Maximum number of milliseconds to wait until updating data automatically"
  >
    <type>number</type>
    <type>null</type>
  </configurationProperty>
  <configurationProperty
    name="unwrapAccounts"
    defaultValue="true"
    description="Unwrap child items of account item, if there is only one account"
  >
    <type>boolean</type>
  </configurationProperty>
  <configurationProperty
    name="unwrapProjects"
    defaultValue="true"
    description="Unwrap child items of project item, if there is only one project"
  >
    <type>boolean</type>
  </configurationProperty>
</plugin>
