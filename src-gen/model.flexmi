      implementation="getComments(project, workItemId, top, continuationToken, includeDeleted, expand, order)"
    >
      <parameter name="project" type="string" />
      <parameter name="workItemId" type="number" />
      <parameter name="top" type="number | undefined" />
      <parameter name="continuationToken" type="string | undefined" />
      <parameter name="includeDeleted" type="boolean | undefined" />
      <parameter name="expand" type="WorkItemTrackingInterfaces.CommentExpandOptions | undefined" />
      <parameter name="order" type="WorkItemTrackingInterfaces.CommentSortOrder | undefined" />
    </serviceMethod>
    <serviceMethod
      name="comment"
      outputType="WorkItemTrackingInterfaces.Comment"
      implementation="getComment(project, workItemId, commentId, includeDeleted, expand)"
    >
      <parameter name="project" type="string" />
      <parameter name="workItemId" type="number" />
      <parameter name="commentId" type="number" />
      <parameter name="includeDeleted" type="boolean | undefined" />
      <parameter name="expand" type="WorkItemTrackingInterfaces.CommentExpandOptions | undefined" />
