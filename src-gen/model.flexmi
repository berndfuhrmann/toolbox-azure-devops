  <service name="WorkItemTracking">
    <delegateToBatchServiceMethod
      name="workItem"
      outputType="WorkItemTrackingInterfaces.WorkItem"
      batchKeyParam="id"
      batchKeyProperty="id"
      batchFetch="getWorkItems(batchIds, undefined, undefined, WorkItemTrackingInterfaces.WorkItemExpand.All, undefined, project)"
    >
      <parameter name="id" type="number" />
      <parameter name="project" type="string | undefined" />
    </delegateToBatchServiceMethod>
    <batchServiceMethod
      name="workItems"
      outputType="WorkItemTrackingInterfaces.WorkItem[]"
      coordinatedMethodName="workItem"
      batchIdsParam="ids"
    >
      <parameter name="ids" type="number[]" />
      <parameter name="project" type="string | undefined" />
    </batchServiceMethod>
    <serviceMethod
      name="queryByWiql"
      outputType="WorkItemTrackingInterfaces.WorkItemQueryResult"
      implementation="queryByWiql(query, teamContext, timePrecision, top)"
    >
      <parameter name="query" type="WorkItemTrackingInterfaces.Wiql" />
      <parameter name="teamContext" type="CoreInterfaces.TeamContext | undefined" />
      <parameter name="timePrecision" type="boolean | undefined" />
      <parameter name="top" type="number | undefined" />
    </serviceMethod>
    <serviceMethod
      name="queries"
      outputType="WorkItemTrackingInterfaces.QueryHierarchyItem[]"
      implementation="getQueries(project, expand, depth, includeDeleted)"
    >
