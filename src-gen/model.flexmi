    </serviceMethod>
    <serviceMethod
      name="dashboard"
      outputType="DashboardInterfaces.Dashboard"
      implementation="getDashboard(teamContext, dashboardId)"
    >
      <parameter name="teamContext" type="CoreInterfaces.TeamContext" />
      <parameter name="dashboardId" type="string" />
    </serviceMethod>
  </service>
  <service name="ExtensionManagement" />
  <service name="FeatureManagement" />
  <service name="FileContainer">
    <serviceMethod
      name="container"
      outputType="FileContainerInterfaces.FileContainer[]"
      implementation="getContainers(scope, artifactUris)"
    >
      <parameter name="scope" type="string | undefined" />
      <parameter name="artifactUris" type="string | undefined" />
    </serviceMethod>
    <serviceMethod
      name="items"
      outputType="FileContainerInterfaces.FileContainerItem[]"
      implementation="getItems(containerId)"
    >
      <parameter name="containerId" type="number" />
      <parameter name="scope" type="string | undefined" />
      <parameter name="itemPath" type="string | undefined" />
      <parameter name="metadata" type="boolean | undefined" />
      <parameter name="format" type="string | undefined" />
      <parameter name="downloadFileName" type="string | undefined" />
      <parameter name="includeDownloadTickets" type="boolean | undefined" />
      <parameter name="isShallow" type="boolean | undefined" />
      <parameter name="ignoreRequestedMediaType" type="boolean | undefined" />
      <parameter name="includeBlobMetadata" type="boolean | undefined" />
      <parameter name="saveAbsolutePath" type="boolean | undefined" />
      <parameter name="preferRedirect" type="boolean | undefined" />
    </serviceMethod>
  </service>
  <service name="Gallery" />
  <service name="Git">
    <serviceMethod
      name="repositories"
      outputType="GitInterfaces.GitRepository[]"
      implementation="getRepositories(project)"
    >
      <parameter name="project" type="string | undefined" />
    </serviceMethod>
    <serviceMethod
      name="repository"
      outputType="GitInterfaces.GitRepository"
      implementation="getRepository(repositoryId, project)"
    >
      <parameter name="repositoryId" type="string" />
      <parameter name="project" type="string | undefined" />
    </serviceMethod>

    <serviceMethod
      name="branches"
      outputType="GitInterfaces.GitBranchStats[]"
      implementation="getBranches(repositoryId)"
    >
      <parameter name="repositoryId" type="string" />
    </serviceMethod>
    <serviceMethod
      name="commits"
      outputType="GitInterfaces.GitCommitRef[]"
      implementation="getCommits(repositoryId, searchCriteria, project)"
    >
      <parameter name="repositoryId" type="string" />
      <parameter name="searchCriteria" type="GitInterfaces.GitQueryCommitsCriteria" />
      <parameter name="project" type="string | undefined" />
    </serviceMethod>
    <serviceMethod
      name="commit"
      outputType="GitInterfaces.GitCommitRef"
      implementation="getCommit(commitId, repositoryId, project)"
    >
      <parameter name="commitId" type="string" />
      <parameter name="repositoryId" type="string" />
      <parameter name="project" type="string | undefined" />
    </serviceMethod>
    <serviceMethod
      name="pullRequests"
      outputType="GitInterfaces.GitPullRequest[]"
      implementation="getPullRequests(repositoryId, {})"
    >
      <parameter name="repositoryId" type="string" />
      <parameter name="status" type="number | undefined" />
    </serviceMethod>
    <serviceMethod
      name="pullRequestById"
      outputType="GitInterfaces.GitPullRequest"
      implementation="getPullRequestById(pullRequestId, project)"
    >
      <parameter name="pullRequestId" type="number" />
      <parameter name="project" type="string | undefined" />
    </serviceMethod>
    <serviceMethod
      name="threads"
      outputType="GitInterfaces.GitPullRequestCommentThread[]"
      implementation="getThreads(repositoryId, pullRequestId, project)"
    >
      <parameter name="repositoryId" type="string" />
      <parameter name="pullRequestId" type="number" />
      <parameter name="project" type="string | undefined" />
    </serviceMethod>
    <serviceMethod
      name="comments"
      outputType="GitInterfaces.Comment[]"
      implementation="getComments(repositoryId, pullRequestId, threadId, project)"
    >
      <parameter name="repositoryId" type="string" />
      <parameter name="pullRequestId" type="number" />
      <parameter name="threadId" type="number" />
      <parameter name="project" type="string | undefined" />
    </serviceMethod>
    <serviceMethod
      name="pullRequestStatuses"
      outputType="GitInterfaces.GitPullRequestStatus[]"
      implementation="getStatuses(commitId, repositoryId, project, undefined, undefined, latestOnly)"
    >
      <parameter name="commitId" type="string" />
      <parameter name="repositoryId" type="string" />
      <parameter name="project" type="string | undefined" />
      <parameter name="latestOnly" type="boolean | undefined" optional="true" defaultValue="false" />
    </serviceMethod>
    <serviceMethod
      name="pullRequestWorkItemRefs"
      outputType="VSSInterfaces.ResourceRef[]"
      implementation="getPullRequestWorkItemRefs(repositoryId, pullRequestId, project)"
    >
      <parameter name="repositoryId" type="string" />
      <parameter name="pullRequestId" type="number" />
      <parameter name="project" type="string | undefined" />
    </serviceMethod>
    <serviceMethod
      name="items"
      outputType="GitInterfaces.GitItem[]"
      implementation="getItems(repositoryId, project, scopePath, recursionLevel, includeContentMetadata, latestProcessedChange, download, includeLinks, versionDescriptor, zipForUnix)"
    >
      <parameter name="repositoryId" type="string" />
      <parameter name="project" type="string | undefined" />
      <parameter name="scopePath" type="string | undefined" />
      <parameter name="recursionLevel" type="GitInterfaces.VersionControlRecursionType | undefined" />
      <parameter name="includeContentMetadata" type="boolean | undefined" />
      <parameter name="latestProcessedChange" type="boolean | undefined" />
      <parameter name="download" type="boolean | undefined" />
      <parameter name="includeLinks" type="boolean | undefined" />
      <parameter name="versionDescriptor" type="GitInterfaces.GitVersionDescriptor | undefined" />
      <parameter name="zipForUnix" type="boolean | undefined" />
    </serviceMethod>
    <serviceMethod
      name="refs"
      outputType="GitInterfaces.GitRef[]"
      implementation="getRefs(repositoryId, project, filter, includeLinks, includeStatuses, includeMyBranches, latestStatusesOnly, peelTags, filterContains)"
    >
      <parameter name="repositoryId" type="string" />
      <parameter name="project" type="string | undefined" />
      <parameter name="filter" type="string | undefined" />
      <parameter name="includeLinks" type="boolean | undefined" />
      <parameter name="includeStatuses" type="boolean | undefined" />
      <parameter name="includeMyBranches" type="boolean | undefined" />
      <parameter name="latestStatusesOnly" type="boolean | undefined" />
      <parameter name="peelTags" type="boolean | undefined" />
      <parameter name="filterContains" type="string | undefined" />
    </serviceMethod>
  </service>
  <service name="Locations" />
  <service name="Management" />
  <service name="Notification" />
