    <serviceMethod
      name="query"
      outputType="WorkItemTrackingInterfaces.QueryHierarchyItem"
      implementation="getQuery(project, query, expand, depth, includeDeleted, useIsoDateFormat)"
    >
      <parameter name="project" type="string" />
      <parameter name="query" type="string" />
      <parameter name="expand" type="WorkItemTrackingInterfaces.QueryExpand | undefined" />
      <parameter name="depth" type="number | undefined" />
      <parameter name="includeDeleted" type="boolean | undefined" />
      <parameter name="useIsoDateFormat" type="boolean | undefined" />
    </serviceMethod>
    <serviceMethod
      name="classificationNode"
      outputType="WorkItemTrackingInterfaces.WorkItemClassificationNode"
      implementation="getClassificationNode(project, structureGroup, path, depth)"
    >
      <parameter name="project" type="string" />
      <parameter name="structureGroup" type="WorkItemTrackingInterfaces.TreeStructureGroup" />
      <parameter name="path" type="string | undefined" />
      <parameter name="depth" type="number | undefined" />
    </serviceMethod>
    <serviceMethod
      name="classificationNodes"
      outputType="WorkItemTrackingInterfaces.WorkItemClassificationNode[]"
